# Perfil de despliegue LOCAL en Windows del backend + broker SOL (Domain G). Copie a `sol-local.env` (ignorado por git)
# y complete. NUNCA suba `sol-local.env`. Este perfil NO sustituye al docker-compose de desarrollo (que mantiene
# SOL_BROKER_ENABLED=false a proposito).

# --- Base de datos (PostgreSQL del docker-compose publicado en loopback, o uno propio) ---
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@127.0.0.1:5432/NOMBRE_BD
ENVIRONMENT=production
TIMEZONE=America/Lima
LOG_LEVEL=INFO
# Genere con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=GENERE_UN_VALOR_ALEATORIO_PROPIO
SESSION_COOKIE_SECURE=false
DOCUMENT_STORAGE_ROOT=C:\LuisIAContable\documents

# --- Broker SOL (loopback + mTLS; mismo proceso que el backend) ---
SOL_BROKER_ENABLED=true
SOL_BROKER_HOST=127.0.0.1
SOL_BROKER_PAIRING_PORT=8995
SOL_BROKER_OPERATIONAL_PORT=8996
# Directorio de la CA del broker (CLAVE PRIVADA incluida): fuera del repositorio, fuera de Docker, solo el usuario actual.
SOL_BROKER_CA_DIR=C:\LuisIAContable\sol_broker_pki
# Genere con: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PAIRING_VERIFIER_KEY=GENERE_32_BYTES_ALEATORIOS_EN_BASE64
# La boveda SOL vive en memoria de UN proceso: 1 es el unico valor aceptado.
BACKEND_WORKERS=1
