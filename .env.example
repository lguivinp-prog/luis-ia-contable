# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo ".env" real al repositorio ni compartas su contenido.

# ---- Entorno general ----
ENVIRONMENT=development
TIMEZONE=America/Lima
LOG_LEVEL=INFO

# ---- Base de datos (Postgres) ----
POSTGRES_USER=luis_ia_contable
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=luis_ia_contable
POSTGRES_PORT=5432
# Usada por el backend para conectarse al servicio "db" del docker-compose
DATABASE_URL=postgresql+psycopg://luis_ia_contable:change-me-dev-only@db:5432/luis_ia_contable

# ---- Base de datos de pruebas (usada solo por pytest) ----
TEST_DATABASE_URL=postgresql+psycopg://luis_ia_contable:change-me-dev-only@db:5432/luis_ia_contable_test

# ---- Seguridad de sesión ----
# Genera un valor aleatorio propio, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-random-64-char-secret
SESSION_COOKIE_NAME=luis_ia_contable_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# ---- Backend / Frontend ----
BACKEND_PORT=8010
FRONTEND_PORT=3010
NEXT_PUBLIC_APP_ENV=development
# URL interna (red de Docker) que el servidor de Next.js usa para reenviar /api/* al backend
BACKEND_INTERNAL_URL=http://backend:8000

# ---- Bloqueo de login por intentos fallidos ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15
LOGIN_LOCKOUT_MAX_MINUTES=60

# ---- Seguridad de sesiones ----
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
SESSION_INACTIVITY_WARNING_SECONDS=60
SESSION_MAX_CONCURRENT=5

# ---- Motor de cronogramas: limites de importacion CSV ----
TAX_SCHEDULE_CSV_MAX_BYTES=2000000
TAX_SCHEDULE_CSV_MAX_ROWS=5000

# ---- Proveedor de consulta de RUC ----
# "fake": datos simulados para desarrollo (por defecto). "sunat": NO IMPLEMENTADO todavia (Fase futura).
RUC_LOOKUP_PROVIDER=fake
RUC_LOOKUP_API_TOKEN=

# ---- Fase 3, Bloque 3.1: integracion Google OAuth (identidad, ver ADR-0062/ADR-0063) ----
# Vacios por defecto: la integracion queda deliberadamente no configurada
# (INTEGRATION_MISCONFIGURED en el momento de uso) hasta registrar un
# proyecto OAuth real en Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROVIDER=fake
APP_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_BASE_URL=http://localhost:3000

# ---- Cifrado de credenciales de integracion (ADR-0064) ----
# Clave base64 de 32 bytes decodificados, p. ej.:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Vacia por defecto: sin ella, la integracion Google falla cerrado.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_KEY_ID=v1

ANTHROPIC_API_KEY=
